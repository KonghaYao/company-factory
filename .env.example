# Example only. Never commit real credentials to the source repository.
COMPANY_HOME=/absolute/private/path/company-data
# 可选：显式覆盖。宿主私有 0600 JSON；显式 scope 优先于自动共享供给。
# JSON: {"stores":[{"companyId":"<后端生成的公司ID>","agentId":"<AgentID>","url":"http://127.0.0.1:<端口>","authToken":"<仅宿主持有的凭据>"}]}
# 不同 scope 可共用同一回环 URL；同一 scope 重复配置会被拒绝。
# 文件必须由宿主所有且为 0600，且位于 Agent / 知识库 / Workspace runtime / 项目可见目录之外。
# 不使用显式覆盖时，注释/删除本行；路径存在但不可读或格式无效会明确失败，不会静默回退。
COMPANY_WASM_STORES_FILE=/absolute/private/path/wasm-stores.json
# 可选：设置绝对路径的官方 sqld 后启用“单一共享 sqld”自动供给。
# 服务只启动一个 sqld；数据、Ed25519 密钥与无秘密 manifest 位于 $COMPANY_SQLD_ROOT/sqld/shared。
# JWT 仅在内存按需签发，不写入 stores.json、Agent 目录、effective-config 或日志。
# COMPANY_SQLD_BINARY=/absolute/path/to/sqld
# 默认 $HOME/.company-host；根目录及 sqld/shared 子目录必须由所有者持有且为 0700，
# 且位于项目与 ~/.company/agents/runtime 之外；不会自动 chmod 既有目录。
# COMPANY_SQLD_ROOT=/absolute/private/path/company-host
# COMPANY_SQLD_PORT=18081
# COMPANY_SQLD_START_TIMEOUT_MS=10000
COMPANY_HOST=127.0.0.1
PORT=3000
# Optional; set to disabled to skip the host Workspace MCP; File/Git stay fail closed.
# COMPANY_WORKSPACE=
# Optional; otherwise generated locally in COMPANY_HOME/owner-token
# COMPANY_WEB_TOKEN=
# Model selection is a host-owned, 0600 YAML library (profile → provider → model).
# Path defaults to $COMPANY_HOME/model-library.yaml. It must be an absolute path
# outside agents/, companys/ and runtime/workspace/ when overridden.
# COMPANY_MODEL_LIBRARY=/absolute/private/path/model-library.yaml
#
# Provider endpoint/credential values are read only from the trusted host process
# environment; the library stores variable *names*, never values. v2 nests
# providers and profiles by id and has no top-level `models` or literal baseUrl.
# Example library:
#
# version: 2
# activeProfile: default
# providers:
#   host-openai:
#     type: openai
#     baseUrlEnv: OPENAI_BASE_URL
#     apiKeyEnv: OPENAI_API_KEY
# profiles:
#   default:
#     activeAlias: sonnet
#     tiers:
#       fable:
#         provider: host-openai
#         modelEnv: OPENAI_DEFAULT_FABLE_MODEL
#       opus:
#         provider: host-openai
#         modelEnv: OPENAI_DEFAULT_OPUS_MODEL
#       sonnet:
#         provider: host-openai
#         modelEnv: OPENAI_DEFAULT_SONNET_MODEL
#       haiku:
#         provider: host-openai
#         modelEnv: OPENAI_DEFAULT_HAIKU_MODEL
OPENAI_BASE_URL=https://YOUR-PROVIDER/v1
OPENAI_API_KEY=
OPENAI_DEFAULT_SONNET_MODEL=YOUR-SONNET-MODEL
OPENAI_DEFAULT_OPUS_MODEL=YOUR-OPUS-MODEL
OPENAI_DEFAULT_HAIKU_MODEL=YOUR-HAIKU-MODEL
OPENAI_DEFAULT_FABLE_MODEL=YOUR-FABLE-MODEL
